# Production requires an explicit target. A Vercel Preview can use only the
# standard public Supabase variables when they point exactly to HML; writes are
# always disabled in that path.
ECONTROLL_SUPABASE_TARGET=production
ECONTROLL_PROD_ENABLED=false
ECONTROLL_PROD_PROJECT_ID=wlqsjwofypqxwleacsvh
ECONTROLL_PROD_SUPABASE_URL=https://wlqsjwofypqxwleacsvh.supabase.co
ECONTROLL_PROD_SITE_URL=https://e-control-delta.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://wlqsjwofypqxwleacsvh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Write actions remain disabled until separate production approval.
ECONTROLL_PROD_COMPANY_MANAGEMENT_ENABLED=false
ECONTROLL_PROD_COMPANY_CREATION_ENABLED=false
ECONTROLL_PROD_COMPANY_INVITATIONS_ENABLED=false
